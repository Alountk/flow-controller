# Flow Controller — Environment Variables
# Copia este archivo como .env y rellena tus valores reales.

# Radarr
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Sonarr
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# aMuTorrent
AMUTORRENT_URL=http://localhost:4000
AMUTORRENT_API_KEY=
# Credenciales de la web UI (necesarias para el WebSocket de control /ws)
AMUTORRENT_USER=admin
AMUTORRENT_PASSWORD=

# Modo seguro: bloquea acciones destructivas en el backend
SAFE_MODE=true
