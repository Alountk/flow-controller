# Flow Controller — solo BOOTSTRAP
#
# Estas variables se leen UNA vez, en el primer arranque, cuando todavía no
# existe settings.json: con ellas se genera el fichero y a partir de ahí dejan
# de tener efecto. La configuración vive en settings.json y se edita desde la
# pestaña Configuración de la interfaz.
#
# Antes se aplicaban en cada arranque y pisaban el fichero en silencio, de modo
# que cambiar una URL o una API key en la interfaz no surtía efecto.
#
# Si ya tienes settings.json, cambiar este fichero NO hará nada.
# Radarr
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Sonarr
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# AmuTorrent
AMUTORRENT_URL=http://localhost:4000
AMUTORRENT_API_KEY=
AMUTORRENT_USER=admin
AMUTORRENT_PASSWORD=

# Seguridad
SAFE_MODE=true
# API key para proteger endpoints de acciones y tareas (vacío = sin auth)
# El frontend la obtiene automáticamente del backend al arrancar
API_KEY=

# Desarrollador (muestra pestaña de prototipos)
DEVELOPER=false

# Rutas de descarga en el host
FOLDER_DOWNLOAD_AMULE=/mnt/storage-6tb/shared-downloads/amule
FOLDER_DOWNLOAD_TORRENT=/mnt/storage/downloads/qbittorrent/completed

# Intervalos
CHECK_INTERVAL=15
MAX_RETRIES=3
RETRY_DELAY=2
REQUEST_TIMEOUT=5
# Timeout para verificación de import después de copy_files (segundos)
IMPORT_TIMEOUT=40

# Trazabilidad
TRACE_LIMIT=25

# Indexador Torznab de aMuTorrent (auto-derivado si se deja vacío)
AMUTORRENT_INDEXER=
