# Flow Controller — variables de ARRANQUE
#
# Rellenan HUECOS: se aplican solo cuando settings.json no tiene ya un valor
# para ese campo. Sirven para sembrar una instalación nueva y como vía de
# rescate, pero NUNCA pisan lo que hayas guardado desde la interfaz.
#
#   interfaz guarda un valor -> el fichero manda -> esta variable se ignora
#   el fichero no lo tiene    -> se aplica esta variable
#
# Antes se aplicaban en cada arranque y pisaban el fichero en silencio, de modo
# que cambiar una URL o una API key en la interfaz no surtía efecto.
#
# La API_KEY de aquí se guarda HASHEADA en settings.json, nunca en claro.
#
# FC_SECRET cifra las credenciales de Radarr/Sonarr/aMuTorrent en settings.json.
# NO se guarda en el fichero: sin ella, el fichero por sí solo no basta para
# leerlas. Si la cambias, las credenciales guardadas quedan ilegibles y hay que
# volver a introducirlas (la app te lo dirá).
FC_SECRET=
# Radarr
RADARR_URL=http://localhost:7878
RADARR_API_KEY=

# Sonarr
SONARR_URL=http://localhost:8989
SONARR_API_KEY=

# AmuTorrent
AMUTORRENT_URL=http://localhost:4000
AMUTORRENT_API_KEY=
AMUTORRENT_USER=admin
AMUTORRENT_PASSWORD=

# Seguridad
SAFE_MODE=true
# API key para proteger endpoints de acciones y tareas (vacío = sin auth)
# El frontend la obtiene automáticamente del backend al arrancar
API_KEY=

# Desarrollador (muestra pestaña de prototipos)
DEVELOPER=false

# Rutas de descarga en el host
FOLDER_DOWNLOAD_AMULE=/mnt/storage-6tb/shared-downloads/amule
FOLDER_DOWNLOAD_TORRENT=/mnt/storage/downloads/qbittorrent/completed

# Intervalos
CHECK_INTERVAL=15
MAX_RETRIES=3
RETRY_DELAY=2
REQUEST_TIMEOUT=5
# Timeout para verificación de import después de copy_files (segundos)
IMPORT_TIMEOUT=40

# Trazabilidad
TRACE_LIMIT=25

# Indexador Torznab de aMuTorrent (auto-derivado si se deja vacío)
AMUTORRENT_INDEXER=
